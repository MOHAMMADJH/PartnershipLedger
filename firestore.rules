rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to all users for now
    // In a production environment, you would want to restrict this
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Example of more restrictive rules for future implementation:
    // match /partners/{partnerId} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
    
    // match /fund_summary/{document} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
    
    // match /capital_transactions/{transactionId} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
    
    // match /purchase_transactions/{transactionId} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
    
    // match /sale_transactions/{transactionId} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
    
    // match /inventory/{itemId} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
    
    // match /profit_distribution_log/{distributionId} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
  }
}
